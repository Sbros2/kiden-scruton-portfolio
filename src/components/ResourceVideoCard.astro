---
const { entry } = Astro.props;
const r = entry.data;
---
<article style="
  border:1px solid rgba(29,233,182,0.22);
  border-radius:14px;
  background:#0e1418;
  overflow:hidden;
">
  {r.thumbnail && (
    <img src={r.thumbnail} alt={r.title}
         style="width:100%;height:120px;object-fit:cover;border-bottom:1px solid rgba(29,233,182,0.22)" />
  )}
  <div style="padding:10px">
    <div style="font-size:12px;color:#ffb74d;font-weight:700;letter-spacing:.5px">YouTube</div>
    <a href={r.href} target="_blank" rel="noopener"
       style="display:block;color:#dff6f3;font-weight:700;margin:4px 0 2px 0;text-decoration:none">
      {r.title}
    </a>
    {r.channel && <div style="color:#90a2a6;font-size:12px">by {r.channel}</div>}
  </div>
</article>
