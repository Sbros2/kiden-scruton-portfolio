---
const { stroke = "rgba(126,238,212,0.12)" } = Astro.props;
---
<style>
  .hexlayer{position:fixed;inset:0;z-index:-1;pointer-events:none}
  .hexlayer svg{width:100%;height:100%}
  .pulse{animation:pulse 8s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:.5}50%{opacity:1}}
</style>
<div class="hexlayer">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <pattern id="hex" width="10" height="8.66" patternUnits="userSpaceOnUse">
        <path d="M2.5,0 L7.5,0 L10,4.33 L7.5,8.66 L2.5,8.66 L0,4.33 Z"
              fill="none" stroke={stroke} stroke-width="0.2"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hex)" class="pulse"/>
  </svg>
</div>
