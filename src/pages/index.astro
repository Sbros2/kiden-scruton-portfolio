---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIntro from '../components/HeroIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {getCollection} from 'astro:content';
const entries=await getCollection('projects');
const projects=['brennan-gyro-monorail','rocksat-c','arsh','hazard-sensing-robot'].map(slug=>entries.find(p=>p.slug===slug)).filter(Boolean);
---
<BaseLayout>
 <div class="home-content">
 <HeroIntro/>
 <section id="selected-work" class="section-block"><div class="section-top"><div><p class="eyebrow">Selected work</p><h2>Built, tested, refined.</h2></div><a class="text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a></div><div class="project-grid">{projects.map((entry,i)=><ProjectCard entry={entry} number={i+1}/>)}</div><div style="display:flex;justify-content:flex-end;margin-top:26px"><a class="text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a></div></section>
 <section class="lab-callout">
  <div>
   <p class="eyebrow">Interactive lab</p>
   <h2>CAD, simulations, and live hardware hooks.</h2>
  </div>
  <p>A focused page for the technical layer behind the projects: assembly viewers, interactive simulations, and a Pi/server dashboard contract that can later connect to real telemetry.</p>
  <a class="text-link" href="/lab/">Open the lab <span aria-hidden="true">→</span></a>
 </section>
 <section class="experience-strip"><p class="eyebrow">Beyond the projects</p><h2>Practical experience.<br/>A collaborative approach.</h2><div><p>My experience spans prototyping and development at HiveTech AI, technical deployment at Diagnostic Devices Inc., and helping students build in the Makerspace.</p><a class="text-link" href="/about/">Experience & background <span aria-hidden="true">→</span></a></div></section>
 </div>
</BaseLayout>
<style>
 .home-content :global(.hero-copy),.home-content :global(.card-copy),.home-content .experience-strip{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 10px 30px #0003}
 .home-content :global(.hero-copy){padding:30px}
 .home-content :global(.card-copy){padding:24px;margin-top:12px}
 .home-content .experience-strip{padding:30px}
 @media(max-width:700px){.home-content :global(.hero-copy),.home-content :global(.card-copy),.home-content .experience-strip{padding:22px}.home-content :global(.hero h1){font-size:clamp(36px,10vw,50px)}}
</style>
<style>.experience-strip{display:grid;grid-template-columns:1fr 1.6fr;gap:18px 70px;border-top:1px solid var(--border);padding-top:35px}.experience-strip>.eyebrow{grid-column:1/-1}.experience-strip h2{font-size:30px;letter-spacing:-1px;line-height:1.3}.experience-strip>div p{font-size:15px;line-height:1.8;color:var(--muted);margin-bottom:20px}@media(max-width:700px){.experience-strip{grid-template-columns:1fr;gap:20px}.experience-strip h2{font-size:27px}}</style>
