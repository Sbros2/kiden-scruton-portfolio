---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import {getCollection} from 'astro:content';
const resources=(await getCollection('resources')).filter(r=>!r.data.href.includes('xxxxx'));
const modelCards = [
  ['Fan print set', 'STL + OBJ', 'Blades, housing, stand, and OBJ stand export from the retro-industrial fan project.'],
  ['Monorail print set', 'STL', 'Motor mount, motor adapter, flywheel, and flywheel adapter from the Brennan-inspired prototype.'],
  ['Mechanical parts', 'STL', 'Split hub clamp, filament holder, and personal modeling archive meshes.'],
];
const simCards = [
  ['Gyro monorail simulator', '/projects/brennan-gyro-monorail/#stabilization-simulator', 'Interactive lean-angle model with flywheel speed, damping, control gain, and torque-limit controls.'],
  ['Engine simulator', '/interests/#engine-sim', 'A JavaScript crank-slider sketch tied to your personal interest in engines and Automation-style design thinking.'],
  ['Circuit and fluids records', '/projects/2025-08-12-pcb-demo/', 'PSpice/EasyEDA piezo documentation, plus COMSOL and MATLAB fluid-study pages linked from the project archive.'],
];
---
<BaseLayout title="Resources | Kiden Scruton" description="Engineering resources, interactive CAD models, simulations, documents, and personal technical references from Kiden Scruton's portfolio.">
  <header class="page-header resources-hero">
    <p class="eyebrow">Resources</p>
    <h1>Tools, models, sims, and reference material.</h1>
    <p class="intro">This page is the index for the technical layer of the portfolio: interactive 3D meshes, small engineering simulations, original project documents, and personal interests that feed the hardware work.</p>
    <div class="resource-actions">
      <a class="button primary" href="/lab/">Open the engineering lab <span aria-hidden="true">→</span></a>
      <a class="button" href="/projects/">Browse projects <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <section class="resource-feature" aria-labelledby="models-title">
    <div>
      <p class="eyebrow">3D model library</p>
      <h2 id="models-title">STL and OBJ models you can rotate, zoom, and explode.</h2>
      <p>The lab viewer now loads real mesh exports from your folders instead of acting like a placeholder. It includes the fan project, monorail printed parts, shop utility parts, and personal model files. The multi-part sets are arranged for inspection and exploded viewing; single meshes load as standalone parts.</p>
      <a class="text-link" href="/lab/">Launch the 3D viewer →</a>
    </div>
    <div class="resource-mini-grid">
      {modelCards.map(([title, meta, text]) => (
        <article>
          <span>{meta}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="resource-feature" aria-labelledby="sims-title">
    <div>
      <p class="eyebrow">Interactive simulations</p>
      <h2 id="sims-title">Small browser tools that show behavior.</h2>
      <p>The goal is to make the site feel more like a bench notebook: not just screenshots, but controls that let someone test assumptions. Current sims cover the gyroscopic monorail and the engine-interest page, while circuit and fluid pages preserve the source studies and figures.</p>
    </div>
    <div class="resource-link-list">
      {simCards.map(([title, href, text]) => (
        <a href={href}>
          <strong>{title}</strong>
          <span>{text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="resource-feature compact" aria-labelledby="docs-title">
    <div>
      <p class="eyebrow">Documents and archives</p>
      <h2 id="docs-title">Downloadable records behind the pages.</h2>
      <p>These cards collect external references, reports, code files, and original documentation so the portfolio has evidence behind the project writing.</p>
    </div>
  </section>

  <section class="project-grid resource-card-grid" aria-label="Resource cards">
    {resources.map(entry=><ResourceCard entry={entry}/>)}
  </section>
</BaseLayout>

<style>
  .resources-hero .intro{max-width:760px}
  .resource-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
  .resource-feature{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:28px;align-items:start;border:1px solid var(--border);border-radius:var(--radius);background:var(--panel);padding:30px;margin:0 0 32px}
  .resource-feature h2{font-size:30px;letter-spacing:-.9px;margin:10px 0 14px}
  .resource-feature p:not(.eyebrow){color:var(--muted);line-height:1.75;font-size:14px}
  .resource-feature.compact{grid-template-columns:1fr;margin-bottom:22px}
  .resource-mini-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .resource-mini-grid article,.resource-link-list a{border:1px solid var(--border);background:#0d1618;border-radius:10px;padding:18px;min-height:100%}
  .resource-mini-grid span{display:block;color:var(--cyan);font-size:11px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:14px}
  .resource-mini-grid h3{font-size:18px;margin:0 0 9px}
  .resource-mini-grid p{font-size:13px;margin:0}
  .resource-link-list{display:grid;gap:12px}
  .resource-link-list a:hover{border-color:#7ce6c477}
  .resource-link-list strong{display:block;color:var(--cyan);font-size:16px;margin-bottom:6px}
  .resource-link-list span{display:block;color:var(--muted);font-size:13px;line-height:1.6}
  .resource-card-grid{margin-top:0}
  @media(max-width:900px){.resource-feature{grid-template-columns:1fr}.resource-mini-grid{grid-template-columns:1fr}}
</style>
